#!/bin/ksh


CPU_COUNT=`sysctl -n hw.ncpu`

if [[ $CPU_COUNT -le 4 ]]; then

	THREAD_COUNT=$(($CPU_COUNT-1))

else

	THREAD_COUNT=$(($CPU_COUNT-2))

fi

echo "CPU_COUNT is $CPU_COUNT"
echo "THREAD_COUNT $THREAD_COUNT will be used to build"

if [ -z "$1" ]; then

   ninja -j $THREAD_COUNT release_all

else

   ninja -j $THREAD_COUNT "$@"

fi

if [ $? != 0 ]; then

   aucat -i ~/code/operating_system/tool/audio/cpp_build_failed.wav &

else

   aucat -i ~/code/operating_system/tool/audio/cpp_good_build.wav &

fi
